flowchart TD
    subgraph UserManagement["用户管理模块"]
        A1["输入用户名/密码"] -->|1. 提交注册信息| A2["检查用户名是否存在"]
        A2 -->|2. 用户名已存在| A3["提示用户名已存在"]
        A3 -->|3. 重新输入| A1
        A2 -->|4. 用户名可用| A4["保存用户数据"]
        A4 -->|5. 完成注册| A5["注册成功"]
    end

    subgraph LoginProcess["登录模块"]
        B1["输入用户名/密码"] -->|6. 提交登录信息| B2["验证用户信息"]
        B2 -->|7. 信息正确| B3["登录成功"]
        B2 -->|8. 密码错误| B4["提示密码错误"]
        B4 -->|9. 重新输入| B1
        B2 -->|10. 用户不存在| B5["提示用户未注册"]
        B5 -->|11. 跳转到注册| A1
    end